# Used by systemd EnvironmentFile=/etc/tabel/tabel.env
JWT_SECRET=dev-secret-change-me
DATABASE_URL=postgres://tabel:tabel@localhost:5432/tabel?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Bind directly on the host (no Docker). Example: :8080 or 127.0.0.1:8080 behind existing proxy.
HTTP_ADDR=:8080
UNIVERSITY_ID=kstu
TIMEZONE=Asia/Bishkek
STAFF_START=08:00
STAFF_CUTOFF=18:30
LUNCH_START=12:00
LUNCH_END=13:00
DUPLICATE_SCAN_WINDOW=2m
SEMESTER_START=2025-09-01
PREV_SEMESTER_START=2025-02-01
ARCHIVE_GRACE_DAYS=30
# Swagger / local: Basic Auth user:user and POST /auth/login → cookie access_token
BASIC_AUTH_USER=user
BASIC_AUTH_PASSWORD=user
DEV_USER_ID=15b7fbe4-95d0-4319-a6c5-fa1ea13391ed
